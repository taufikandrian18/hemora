# Copy to /opt/hemora/.env on the server.

# Public address Caddy serves. ":80" = plain HTTP on the server IP.
# With a domain pointed at the server, use e.g.:  SITE_ADDRESS=hemora.id, www.hemora.id
SITE_ADDRESS=:80

# Image to run. The deploy workflow overrides this with the exact commit tag;
# set it by hand only to roll back, e.g. ghcr.io/taufikandrian18/hemora:sha-074eb28
# WEB_IMAGE=ghcr.io/taufikandrian18/hemora:latest
