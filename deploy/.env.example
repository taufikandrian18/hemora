# /opt/hemora/.env on the server (never committed).

# Written by attach-to-proxy.sh: Docker network of the shared Caddy proxy (e.g. n8n_default).
PROXY_NETWORK=

# Public WordPress URL (same prefix as the site; wp-admin lives under it).
WP_URL=https://website.taufikandrian.my.id/hemora

# Generate once with:  openssl rand -hex 24
WP_DB_PASSWORD=
WP_DB_ROOT_PASSWORD=
# Shared between WordPress and the website so saving in wp-admin refreshes the site.
REVALIDATE_SECRET=

# Written by the deploy workflow on every release. Set by hand only to roll back, e.g.
# WEB_IMAGE=ghcr.io/taufikandrian18/hemora:sha-074eb28
