# /opt/hemora/.env on the server. attach-to-proxy.sh writes PROXY_NETWORK; the deploy
# workflow writes WEB_IMAGE on every release.

# Docker network of the shared Caddy proxy that owns ports 80/443 (e.g. n8n_default).
PROXY_NETWORK=

# Image to run. Set by hand only to roll back, e.g. ghcr.io/taufikandrian18/hemora:sha-074eb28
# WEB_IMAGE=ghcr.io/taufikandrian18/hemora:latest
